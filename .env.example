# Optional API key. When set, requests must send
# Authorization: Bearer <key>, Basic auth with the key, or x-cachenest-key.
API_KEY=

# HTTP port CacheNest listens on.
PORT=8080

# Interface to bind. Use 127.0.0.1 for local-only access.
HOST=0.0.0.0

# Where cached artifacts and index.sqlite are stored. Supports "~/".
CACHE_DIR=~/.cachenest

# Maximum cache size in gigabytes. Fractions are allowed.
MAX_CACHE_GB=5

# Upstream registries.
UPSTREAM_NPM=https://registry.npmjs.org
UPSTREAM_PYPI=https://pypi.org/simple

# Docker Compose only: host interface and published port.
# CACHENEST_BIND=127.0.0.1
# CACHENEST_PORT=8787
