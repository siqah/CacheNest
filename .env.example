# HTTP port CacheNest listens on when run directly with `npm start`.
PORT=8080

# Interface to bind for direct runs. Keep this on loopback: CacheNest has no
# authentication and is meant for personal, local use.
# The Docker container binds 0.0.0.0 internally; exposure is controlled by
# CACHENEST_BIND instead.
HOST=127.0.0.1

# Where cached artifacts and index.sqlite are stored. Supports "~/".
CACHE_DIR=~/.cachenest

# Maximum cache size in gigabytes. Fractions are allowed.
MAX_CACHE_GB=5

# Upstream registries.
UPSTREAM_NPM=https://registry.npmjs.org
UPSTREAM_PYPI=https://pypi.org/simple

# Docker Compose only: host interface and published port.
# Keep CACHENEST_BIND on loopback. CacheNest does not authenticate clients, so
# do not expose it to other devices.
# CACHENEST_BIND=127.0.0.1
# CACHENEST_PORT=8787
